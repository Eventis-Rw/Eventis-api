// Central database schema for Eventis API.
//
// Prisma owns the relational model. PostgreSQL-specific features that Prisma cannot
// express cleanly (PostGIS geography columns, GiST indexes, deferred constraint
// triggers, generated tsvector columns) are added in SQL migrations and documented
// in docs/guides/migrations.md. See ADR 0009.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm]
}

// ---------- Platform (cross-cutting) ----------

/// Transactional outbox. Written in the same transaction as the business change.
/// Delivery is at-least-once — every consumer must be idempotent.
model Outbox {
  id            BigInt    @id @default(autoincrement())
  aggregateType String    @map("aggregate_type") @db.VarChar(50)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(80)
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0) @db.SmallInt
  lastError     String?   @map("last_error") @db.VarChar(500)

  @@index([aggregateType, aggregateId], map: "outbox_aggregate_idx")
  @@map("outbox")
}

/// Idempotency keys for POSTs that create orders, payments or tickets.
model IdempotencyKey {
  key            String   @db.VarChar(120)
  endpoint       String   @db.VarChar(120)
  requestHash    String   @map("request_hash") @db.Char(64)
  status         String   @db.VarChar(20)
  responseStatus Int?     @map("response_status") @db.SmallInt
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([key, endpoint], map: "idempotency_keys_key_endpoint_pk")
  @@index([createdAt], map: "idempotency_created_idx")
  @@map("idempotency_keys")
}

/// Append-only audit log for admin mutations.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorId     String?  @map("actor_id") @db.Uuid
  actorRole   String   @map("actor_role") @db.VarChar(30)
  action      String   @db.VarChar(80)
  subjectType String   @map("subject_type") @db.VarChar(50)
  subjectId   String?  @map("subject_id") @db.Uuid
  changes     Json     @default("{}")
  requestId   String?  @map("request_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([subjectType, subjectId, id], map: "audit_subject_idx")
  @@index([actorId, id], map: "audit_actor_idx")
  @@map("audit_log")
}

// ---------- Catalog (future module; table kept for seed / discovery) ----------

model Category {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug     String  @unique @db.VarChar(60)
  name     String  @db.VarChar(60)
  iconKey  String? @map("icon_key") @db.VarChar(60)
  position Int     @default(0) @db.SmallInt

  @@index([position], map: "categories_position_idx")
  @@map("categories")
}

// ---------- Identity ----------

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum UserRole {
  CUSTOMER
  ADMIN

  @@map("user_role")
}

enum OtpPurpose {
  SIGN_IN
  SIGN_UP

  @@map("otp_purpose")
}

model User {
  id                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone                   String      @unique @db.VarChar(30)
  firstName               String?     @map("first_name") @db.VarChar(100)
  lastName                String?     @map("last_name") @db.VarChar(100)
  email                   String?     @unique @db.VarChar(255)
  accountType             AccountType @default(CUSTOMER) @map("account_type")
  role                    UserRole    @default(CUSTOMER)
  organizationName        String?     @map("organization_name") @db.VarChar(160)
  organizationDescription String?     @map("organization_description") @db.Text
  dateOfBirth             DateTime?   @map("date_of_birth") @db.Date
  gender                  String?     @db.VarChar(30)
  bio                     String?     @db.Text
  location                String?     @db.VarChar(160)
  interestedIn            String?          @map("interested_in") @db.VarChar(30)
  displayName             String?          @map("display_name") @db.VarChar(60)
  avatarUrl               String?          @map("avatar_url") @db.VarChar(500)
  pinHash                 String?          @map("pin_hash") @db.VarChar(128)
  findLoveProfileType     LoveProfileType  @default(PRIVATE) @map("find_love_profile_type")
  status                  UserStatus       @default(ACTIVE)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshSessions RefreshSession[]
  events          Event[]
  eventRegistrations EventRegistration[]
  serviceSubscriptions ServiceSubscription[]

  chatParticipations ConversationParticipant[] @relation("ChatParticipation")
  sentMessages       Message[]                 @relation("MessageSender")
  sentInvitations    ChatInvitation[]          @relation("SentChatInvitations")
  initiatedCalls     Call[]                    @relation("CallInitiator")
  connectionRequestsSent     ConnectionRequest[] @relation("ConnectionRequestsSent")
  connectionRequestsReceived ConnectionRequest[] @relation("ConnectionRequestsReceived")
  blocksCreated      UserBlock[]  @relation("BlocksCreated")
  blocksReceived     UserBlock[]  @relation("BlocksReceived")
  reportsCreated     UserReport[] @relation("ReportsCreated")
  reportsReceived    UserReport[] @relation("ReportsReceived")

  @@map("users")
}

enum AccountType {
  POSTER
  CUSTOMER
  LOVE

  @@map("account_type")
}

model OtpVerification {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone       String       @db.VarChar(30)
  codeHash    String       @map("code_hash") @db.VarChar(128)
  purpose     OtpPurpose   @default(SIGN_IN)
  firstName   String?      @map("first_name") @db.VarChar(100)
  accountType AccountType? @map("account_type")
  pinHash     String?      @map("pin_hash") @db.VarChar(128)
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(6)
  attempts    Int          @default(0) @db.SmallInt
  verifiedAt  DateTime?    @map("verified_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, purpose], map: "otp_phone_purpose_idx")
  @@index([phone, createdAt], map: "otp_phone_created_idx")
  @@map("otp_verifications")
}

model RefreshSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId], map: "refresh_sessions_family_idx")
  @@index([userId, createdAt], map: "refresh_sessions_user_idx")
  @@map("refresh_sessions")
}

enum EventStatus {
  draft
  published
  cancelled

  @@map("event_status")
}

model Event {
  eventId     String      @id @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  title       String      @db.VarChar(160)
  description String?     @db.Text
  coverImage  String?     @map("cover_image") @db.VarChar(500)
  category    String?     @db.VarChar(60)
  location    String      @db.VarChar(255)
  startDate   DateTime    @map("start_date") @db.Date
  time        String      @db.VarChar(20)
  status      EventStatus @default(draft)
  viewsCount  Int         @default(0) @map("views_count")
  posterId    String      @map("poster_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  poster        User                @relation(fields: [posterId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@index([status, startDate], map: "events_status_start_idx")
  @@index([posterId], map: "events_poster_idx")
  @@index([category], map: "events_category_idx")
  @@map("events")
}

model EventRegistration {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], map: "event_registrations_unique")
  @@index([userId], map: "event_registrations_user_idx")
  @@map("event_registrations")
}

// ---------- Chat and messaging ----------

enum MessagingService {
  FINDLOVE
  EVENTIS

  @@map("messaging_service")
}

enum LoveProfileType {
  PRIVATE
  PUBLIC

  @@map("love_profile_type")
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED

  @@map("connection_request_status")
}

enum ConversationType {
  DIRECT
  GROUP

  @@map("conversation_type")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE

  @@map("message_type")
}

enum ReceiptStatus {
  SENT
  DELIVERED
  READ

  @@map("receipt_status")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED

  @@map("invitation_status")
}

enum CallType {
  VOICE
  VIDEO

  @@map("call_type")
}

enum CallStatus {
  INITIATED
  RINGING
  ACCEPTED
  REJECTED
  MISSED
  ENDED
  CANCELLED

  @@map("call_status")
}

model Conversation {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          ConversationType  @default(DIRECT)
  service       MessagingService
  contextId     String?           @map("context_id") @db.Uuid
  title         String?           @db.VarChar(120)
  directPairKey String?           @unique @map("direct_pair_key") @db.VarChar(100)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  participants      ConversationParticipant[]
  messages          Message[]
  calls             Call[]
  connectionRequest ConnectionRequest?

  @@index([updatedAt], map: "conversations_updated_idx")
  @@index([service], map: "conversations_service_idx")
  @@index([service, contextId], map: "conversations_service_context_idx")
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(6)
  isArchived     Boolean   @default(false) @map("is_archived")
  isMuted        Boolean   @default(false) @map("is_muted")

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation("ChatParticipation", fields: [userId], references: [id], onDelete: Cascade)
  receipts     MessageReceipt[]

  @@unique([conversationId, userId], map: "conversation_participants_unique")
  @@index([userId, conversationId], map: "conversation_participants_user_idx")
  @@map("conversation_participants")
}

model Message {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String      @map("conversation_id") @db.Uuid
  senderId        String      @map("sender_id") @db.Uuid
  type            MessageType @default(TEXT)
  content         String?     @db.Text
  replyToId       String?     @map("reply_to_id") @db.Uuid
  clientMessageId String?     @map("client_message_id") @db.VarChar(80)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  editedAt        DateTime?   @map("edited_at") @db.Timestamptz(6)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(6)

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]           @relation("MessageReplies")
  attachments  MessageAttachment[]
  receipts     MessageReceipt[]

  @@unique([senderId, clientMessageId], map: "messages_sender_client_id_key")
  @@index([conversationId, createdAt, id], map: "messages_conversation_created_idx")
  @@index([senderId, createdAt], map: "messages_sender_created_idx")
  @@map("messages")
}

model MessageAttachment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  fileName   String   @map("file_name") @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(120)
  sizeBytes  Int      @map("size_bytes")
  storageKey String   @map("storage_key") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "message_attachments_message_idx")
  @@map("message_attachments")
}

model MessageReceipt {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId     String        @map("message_id") @db.Uuid
  participantId String        @map("participant_id") @db.Uuid
  status        ReceiptStatus @default(SENT)
  deliveredAt   DateTime?     @map("delivered_at") @db.Timestamptz(6)
  readAt        DateTime?     @map("read_at") @db.Timestamptz(6)

  message     Message                 @relation(fields: [messageId], references: [id], onDelete: Cascade)
  participant ConversationParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([messageId, participantId], map: "message_receipts_unique")
  @@index([participantId, status], map: "message_receipts_participant_status_idx")
  @@map("message_receipts")
}

model ChatInvitation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviterId   String           @map("inviter_id") @db.Uuid
  phoneNumber String           @map("phone_number") @db.VarChar(30)
  tokenHash   String           @unique @map("token_hash") @db.VarChar(128)
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  inviter User @relation("SentChatInvitations", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([inviterId, status], map: "chat_invitations_inviter_status_idx")
  @@index([phoneNumber], map: "chat_invitations_phone_idx")
  @@map("chat_invitations")
}

model Call {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String     @map("conversation_id") @db.Uuid
  callerId       String     @map("caller_id") @db.Uuid
  type           CallType
  status         CallStatus @default(INITIATED)
  startedAt      DateTime   @default(now()) @map("started_at") @db.Timestamptz(6)
  answeredAt     DateTime?  @map("answered_at") @db.Timestamptz(6)
  endedAt        DateTime?  @map("ended_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller       User         @relation("CallInitiator", fields: [callerId], references: [id], onDelete: Cascade)

  @@index([conversationId, startedAt], map: "calls_conversation_started_idx")
  @@index([callerId, startedAt], map: "calls_caller_started_idx")
  @@map("calls")
}

model ConnectionRequest {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId    String                  @map("requester_id") @db.Uuid
  recipientId    String                  @map("recipient_id") @db.Uuid
  conversationId String                  @unique @map("conversation_id") @db.Uuid
  status         ConnectionRequestStatus @default(PENDING)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requester    User         @relation("ConnectionRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient    User         @relation("ConnectionRequestsReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([requesterId, recipientId], map: "connection_requests_pair_idx")
  @@map("connection_requests")
}

model ServiceSubscription {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  service   MessagingService
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, service, expiresAt], map: "service_subscriptions_lookup_idx")
  @@map("service_subscriptions")
}

model UserBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker User @relation("BlocksCreated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId], map: "user_blocks_unique")
  @@index([blockedId], map: "user_blocks_blocked_idx")
  @@map("user_blocks")
}

model UserReport {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String   @map("reporter_id") @db.Uuid
  reportedUserId String   @map("reported_user_id") @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  reason         String   @db.VarChar(80)
  details        String?  @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reporter User @relation("ReportsCreated", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reportedUserId, createdAt], map: "user_reports_subject_idx")
  @@map("user_reports")
}
