// Central database schema for Eventis API.
//
// Prisma owns the relational model. PostgreSQL-specific features that Prisma cannot
// express cleanly (PostGIS geography columns, GiST indexes, deferred constraint
// triggers, generated tsvector columns) are added in SQL migrations and documented
// in docs/guides/migrations.md. See ADR 0009.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm]
}

// ---------- Platform (cross-cutting) ----------

/// Transactional outbox. Written in the same transaction as the business change.
/// Delivery is at-least-once — every consumer must be idempotent.
model Outbox {
  id            BigInt    @id @default(autoincrement())
  aggregateType String    @map("aggregate_type") @db.VarChar(50)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(80)
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0) @db.SmallInt
  lastError     String?   @map("last_error") @db.VarChar(500)

  @@index([aggregateType, aggregateId], map: "outbox_aggregate_idx")
  @@map("outbox")
}

/// Idempotency keys for POSTs that create orders, payments or tickets.
model IdempotencyKey {
  key            String   @db.VarChar(120)
  endpoint       String   @db.VarChar(120)
  requestHash    String   @map("request_hash") @db.Char(64)
  status         String   @db.VarChar(20)
  responseStatus Int?     @map("response_status") @db.SmallInt
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([key, endpoint], map: "idempotency_keys_key_endpoint_pk")
  @@index([createdAt], map: "idempotency_created_idx")
  @@map("idempotency_keys")
}

/// Append-only audit log for admin mutations.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorId     String?  @map("actor_id") @db.Uuid
  actorRole   String   @map("actor_role") @db.VarChar(30)
  action      String   @db.VarChar(80)
  subjectType String   @map("subject_type") @db.VarChar(50)
  subjectId   String?  @map("subject_id") @db.Uuid
  changes     Json     @default("{}")
  requestId   String?  @map("request_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([subjectType, subjectId, id], map: "audit_subject_idx")
  @@index([actorId, id], map: "audit_actor_idx")
  @@map("audit_log")
}

// ---------- Catalog (future module; table kept for seed / discovery) ----------

model Category {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug     String  @unique @db.VarChar(60)
  name     String  @db.VarChar(60)
  iconKey  String? @map("icon_key") @db.VarChar(60)
  position Int     @default(0) @db.SmallInt
  isActive Boolean @default(true) @map("is_active")

  events            Event[]                    @relation("EventCategory")
  publisherProfiles PublisherProfileCategory[]
  userPreferences   UserPreferenceCategory[]

  @@index([position], map: "categories_position_idx")
  @@index([isActive, position], map: "categories_active_position_idx")
  @@map("categories")
}

// ---------- Identity ----------

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum UserRole {
  CUSTOMER
  ADMIN

  @@map("user_role")
}

enum PosterKind {
  INDIVIDUAL
  BUSINESS

  @@map("poster_kind")
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE

  @@map("profile_visibility")
}

enum ModerationStatus {
  OPEN
  REVIEWED
  DISMISSED

  @@map("moderation_status")
}

enum OtpPurpose {
  SIGN_IN
  SIGN_UP

  @@map("otp_purpose")
}

model User {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone                   String            @unique @db.VarChar(30)
  firstName               String?           @map("first_name") @db.VarChar(100)
  lastName                String?           @map("last_name") @db.VarChar(100)
  email                   String?           @unique @db.VarChar(255)
  accountType             AccountType       @default(CUSTOMER) @map("account_type")
  role                    UserRole          @default(CUSTOMER)
  organizationName        String?           @map("organization_name") @db.VarChar(160)
  organizationDescription String?           @map("organization_description") @db.Text
  dateOfBirth             DateTime?         @map("date_of_birth") @db.Date
  gender                  String?           @db.VarChar(30)
  bio                     String?           @db.Text
  location                String?           @db.VarChar(160)
  interestedIn            String?           @map("interested_in") @db.VarChar(30)
  displayName             String?           @map("display_name") @db.VarChar(60)
  avatarUrl               String?           @map("avatar_url") @db.VarChar(500)
  pinHash                 String?           @map("pin_hash") @db.VarChar(128)
  findLoveProfileType     LoveProfileType   @default(PRIVATE) @map("find_love_profile_type")
  username                String?           @unique @db.VarChar(30)
  phoneVerifiedAt         DateTime?         @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt         DateTime?         @map("email_verified_at") @db.Timestamptz(6)
  posterKind              PosterKind        @default(INDIVIDUAL) @map("poster_kind")
  termsVersion            String?           @map("terms_version") @db.VarChar(20)
  termsAcceptedAt         DateTime?         @map("terms_accepted_at") @db.Timestamptz(6)
  activeOrganisationId    String?           @map("active_organisation_id") @db.Uuid
  lastSeenAt              DateTime?         @map("last_seen_at") @db.Timestamptz(6)
  deletedAt               DateTime?         @map("deleted_at") @db.Timestamptz(6)
  profileVisibility       ProfileVisibility @default(PUBLIC) @map("profile_visibility")
  status                  UserStatus        @default(ACTIVE)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshSessions      RefreshSession[]
  events               Event[]
  statuses             Status[]
  statusViews          StatusView[]
  eventRegistrations   EventRegistration[]
  serviceSubscriptions ServiceSubscription[]
  paymentIntents       PaymentIntent[]

  chatParticipations         ConversationParticipant[] @relation("ChatParticipation")
  sentMessages               Message[]                 @relation("MessageSender")
  sentInvitations            ChatInvitation[]          @relation("SentChatInvitations")
  initiatedCalls             Call[]                    @relation("CallInitiator")
  connectionRequestsSent     ConnectionRequest[]       @relation("ConnectionRequestsSent")
  connectionRequestsReceived ConnectionRequest[]       @relation("ConnectionRequestsReceived")
  blocksCreated              UserBlock[]               @relation("BlocksCreated")
  blocksReceived             UserBlock[]               @relation("BlocksReceived")
  reportsCreated             UserReport[]              @relation("ReportsCreated")
  reportsReceived            UserReport[]              @relation("ReportsReceived")
  reportsReviewed            UserReport[]              @relation("ReportsReviewed")

  activeOrganisation            Organisation?               @relation("ActiveOrganisation", fields: [activeOrganisationId], references: [id], onDelete: SetNull)
  ownedOrganisations            Organisation[]              @relation("OrganisationOwner")
  organisationMemberships       OrganisationMember[]
  publisherProfile              PublisherProfile?
  savedEvents                   SavedEvent[]
  savedOrganisers               SavedOrganiser[]
  reviews                       Review[]
  eventReports                  EventReport[]               @relation("EventReportReporter")
  eventReportsReviewed          EventReport[]               @relation("EventReportReviewer")
  notificationPreference        UserNotificationPreference?
  preference                    UserPreference?
  preferenceCategories          UserPreferenceCategory[]
  phoneVerifications            PhoneVerification[]
  notifications                 Notification[]
  pushTokens                    PushToken[]
  uploads                       Upload[]
  supportReports                SupportReport[]
  accountDeletionChallenges     AccountDeletionChallenge[]
  organiserSubscriptions        OrganiserSubscription[]
  businessVerificationsReviewed BusinessVerification[]      @relation("BusinessVerificationReviewer")
  promotions                    Promotion[]                 @relation("PromotionOwner")
  promotionsReviewed            Promotion[]                 @relation("PromotionReviewer")
  analyticsEvents               AnalyticsEvent[]
  ageVerifications              AgeVerification[]           @relation("AgeVerificationOwner")
  ageVerificationsReviewed      AgeVerification[]           @relation("AgeVerificationReviewer")
  loveProfile                   LoveProfile?
  contactAliases                ContactAlias[]              @relation("ContactAliases")
  contactAliasTargets           ContactAlias[]              @relation("ContactAliasTarget")

  @@index([lastSeenAt], map: "users_last_seen_idx")
  @@map("users")
}

enum AccountType {
  POSTER
  CUSTOMER
  LOVE

  @@map("account_type")
}

model OtpVerification {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone       String       @db.VarChar(30)
  codeHash    String       @map("code_hash") @db.VarChar(128)
  purpose     OtpPurpose   @default(SIGN_IN)
  firstName   String?      @map("first_name") @db.VarChar(100)
  accountType AccountType? @map("account_type")
  pinHash     String?      @map("pin_hash") @db.VarChar(128)
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(6)
  attempts    Int          @default(0) @db.SmallInt
  verifiedAt  DateTime?    @map("verified_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, purpose], map: "otp_phone_purpose_idx")
  @@index([phone, createdAt], map: "otp_phone_created_idx")
  @@map("otp_verifications")
}

model RefreshSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId], map: "refresh_sessions_family_idx")
  @@index([userId, createdAt], map: "refresh_sessions_user_idx")
  @@map("refresh_sessions")
}

enum EventStatus {
  draft
  published
  paused
  cancelled

  @@map("event_status")
}

model Event {
  eventId        String      @id @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  title          String      @db.VarChar(160)
  description    String?     @db.Text
  coverImage     String?     @map("cover_image") @db.VarChar(500)
  category       String?     @db.VarChar(60)
  location       String      @db.VarChar(255)
  startDate      DateTime    @map("start_date") @db.Date
  time           String      @db.VarChar(20)
  status         EventStatus @default(draft)
  viewsCount     Int         @default(0) @map("views_count")
  posterId       String      @map("poster_id") @db.Uuid
  organisationId String?     @map("organisation_id") @db.Uuid
  categoryId     String?     @map("category_id") @db.Uuid
  city           String?     @db.VarChar(120)
  latitude       Decimal?    @db.Decimal(9, 6)
  longitude      Decimal?    @db.Decimal(9, 6)
  endDate        DateTime?   @map("end_date") @db.Date
  endTime        String?     @map("end_time") @db.VarChar(20)
  timezone       String      @default("Africa/Kigali") @db.VarChar(40)
  capacity       Int?
  isPaid         Boolean     @default(false) @map("is_paid")
  priceMinor     BigInt?     @map("price_minor")
  currency       String      @default("RWF") @db.Char(3)
  bookingUrl     String?     @map("booking_url") @db.VarChar(500)
  instructions   String?     @db.Text
  tags           String[]    @default([])
  ratingAvg      Decimal     @default(0) @map("rating_avg") @db.Decimal(3, 2)
  reviewCount    Int         @default(0) @map("review_count")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  poster          User                @relation(fields: [posterId], references: [id], onDelete: Cascade)
  organisation    Organisation?       @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  categoryRef     Category?           @relation("EventCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  registrations   EventRegistration[]
  statuses        Status[]
  savedBy         SavedEvent[]
  reviews         Review[]
  reports         EventReport[]
  promotions      Promotion[]
  analyticsEvents AnalyticsEvent[]
  dailyStats      EventStatDaily[]

  @@index([status, startDate], map: "events_status_start_idx")
  @@index([posterId], map: "events_poster_idx")
  @@index([category], map: "events_category_idx")
  @@index([categoryId], map: "events_category_id_idx")
  @@index([organisationId], map: "events_organisation_idx")
  @@index([city], map: "events_city_idx")
  @@index([latitude, longitude], map: "events_location_idx")
  @@map("events")
}

model EventRegistration {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], map: "event_registrations_unique")
  @@index([userId], map: "event_registrations_user_idx")
  @@map("event_registrations")
}

/// Organizer statuses are visible for 24 hours and may link to an event.
model Status {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  eventId    String?      @map("event_id") @db.Uuid
  mediaUrl   String?      @map("media_url") @db.VarChar(1000)
  mediaType  String       @map("media_type") @db.VarChar(10)
  caption    String?      @db.VarChar(1000)
  background String       @default("#101827") @db.VarChar(30)
  fit        String       @default("cover") @db.VarChar(10)
  overlays   Json         @default("[]")
  templateId String?      @map("template_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(6)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event?       @relation(fields: [eventId], references: [eventId], onDelete: SetNull)
  views      StatusView[]

  @@index([expiresAt], map: "statuses_expiry_idx")
  @@index([userId, createdAt], map: "statuses_user_idx")
  @@map("statuses")
}

model StatusView {
  statusId String   @map("status_id") @db.Uuid
  viewerId String   @map("viewer_id") @db.Uuid
  viewedAt DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)
  status   Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([statusId, viewerId], map: "status_views_pkey")
  @@index([viewerId, viewedAt], map: "status_views_viewer_idx")
  @@map("status_views")
}

// ---------- Chat and messaging ----------

enum MessagingService {
  FINDLOVE
  EVENTIS

  @@map("messaging_service")
}

enum LoveProfileType {
  PRIVATE
  PUBLIC

  @@map("love_profile_type")
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED

  @@map("connection_request_status")
}

enum ConversationType {
  DIRECT
  GROUP

  @@map("conversation_type")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE

  @@map("message_type")
}

enum ReceiptStatus {
  SENT
  DELIVERED
  READ

  @@map("receipt_status")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED

  @@map("invitation_status")
}

enum CallType {
  VOICE
  VIDEO

  @@map("call_type")
}

enum CallStatus {
  INITIATED
  RINGING
  ACCEPTED
  REJECTED
  MISSED
  ENDED
  CANCELLED

  @@map("call_status")
}

model Conversation {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          ConversationType @default(DIRECT)
  service       MessagingService
  contextId     String?          @map("context_id") @db.Uuid
  title         String?          @db.VarChar(120)
  directPairKey String?          @unique @map("direct_pair_key") @db.VarChar(100)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  participants      ConversationParticipant[]
  messages          Message[]
  calls             Call[]
  connectionRequest ConnectionRequest?
  LoveConnection    LoveConnection[]

  @@index([updatedAt], map: "conversations_updated_idx")
  @@index([service], map: "conversations_service_idx")
  @@index([service, contextId], map: "conversations_service_context_idx")
  @@map("conversations")
}

model ConversationParticipant {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId         String    @map("conversation_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  joinedAt               DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  lastReadAt             DateTime? @map("last_read_at") @db.Timestamptz(6)
  isArchived             Boolean   @default(false) @map("is_archived")
  isMuted                Boolean   @default(false) @map("is_muted")
  hiddenAt               DateTime? @map("hidden_at") @db.Timestamptz(6)
  clearedBeforeMessageId String?   @map("cleared_before_message_id") @db.Uuid

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation("ChatParticipation", fields: [userId], references: [id], onDelete: Cascade)
  receipts     MessageReceipt[]

  @@unique([conversationId, userId], map: "conversation_participants_unique")
  @@index([userId, conversationId], map: "conversation_participants_user_idx")
  @@map("conversation_participants")
}

model Message {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String      @map("conversation_id") @db.Uuid
  senderId        String      @map("sender_id") @db.Uuid
  type            MessageType @default(TEXT)
  content         String?     @db.Text
  replyToId       String?     @map("reply_to_id") @db.Uuid
  forwardedFromId String?     @map("forwarded_from_id") @db.Uuid
  clientMessageId String?     @map("client_message_id") @db.VarChar(80)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  editedAt        DateTime?   @map("edited_at") @db.Timestamptz(6)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(6)

  conversation  Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo       Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Message[]           @relation("MessageReplies")
  forwardedFrom Message?            @relation("MessageForwards", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards      Message[]           @relation("MessageForwards")
  attachments   MessageAttachment[]
  receipts      MessageReceipt[]
  reports       UserReport[]

  @@unique([senderId, clientMessageId], map: "messages_sender_client_id_key")
  @@index([conversationId, createdAt, id], map: "messages_conversation_created_idx")
  @@index([senderId, createdAt], map: "messages_sender_created_idx")
  @@map("messages")
}

model MessageAttachment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  fileName   String   @map("file_name") @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(120)
  sizeBytes  Int      @map("size_bytes")
  storageKey String   @map("storage_key") @db.VarChar(500)
  durationMs Int?     @map("duration_ms")
  width      Int?
  height     Int?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "message_attachments_message_idx")
  @@map("message_attachments")
}

model MessageReceipt {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId     String        @map("message_id") @db.Uuid
  participantId String        @map("participant_id") @db.Uuid
  status        ReceiptStatus @default(SENT)
  deliveredAt   DateTime?     @map("delivered_at") @db.Timestamptz(6)
  readAt        DateTime?     @map("read_at") @db.Timestamptz(6)

  message     Message                 @relation(fields: [messageId], references: [id], onDelete: Cascade)
  participant ConversationParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([messageId, participantId], map: "message_receipts_unique")
  @@index([participantId, status], map: "message_receipts_participant_status_idx")
  @@map("message_receipts")
}

model ChatInvitation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviterId   String           @map("inviter_id") @db.Uuid
  phoneNumber String           @map("phone_number") @db.VarChar(30)
  tokenHash   String           @unique @map("token_hash") @db.VarChar(128)
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  inviter User @relation("SentChatInvitations", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([inviterId, status], map: "chat_invitations_inviter_status_idx")
  @@index([phoneNumber], map: "chat_invitations_phone_idx")
  @@map("chat_invitations")
}

model Call {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String     @map("conversation_id") @db.Uuid
  callerId       String     @map("caller_id") @db.Uuid
  type           CallType
  status         CallStatus @default(INITIATED)
  startedAt      DateTime   @default(now()) @map("started_at") @db.Timestamptz(6)
  answeredAt     DateTime?  @map("answered_at") @db.Timestamptz(6)
  endedAt        DateTime?  @map("ended_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller       User         @relation("CallInitiator", fields: [callerId], references: [id], onDelete: Cascade)

  @@index([conversationId, startedAt], map: "calls_conversation_started_idx")
  @@index([callerId, startedAt], map: "calls_caller_started_idx")
  @@map("calls")
}

model ConnectionRequest {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId    String                  @map("requester_id") @db.Uuid
  recipientId    String                  @map("recipient_id") @db.Uuid
  conversationId String                  @unique @map("conversation_id") @db.Uuid
  status         ConnectionRequestStatus @default(PENDING)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requester    User         @relation("ConnectionRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient    User         @relation("ConnectionRequestsReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([requesterId, recipientId], map: "connection_requests_pair_idx")
  @@map("connection_requests")
}

model ServiceSubscription {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  service           MessagingService
  accountType       FindLoveAccountType? @map("account_type")
  installmentPlanId String?              @map("installment_plan_id") @db.Uuid
  paymentIntentId   String?              @unique @map("payment_intent_id") @db.Uuid
  expiresAt         DateTime             @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  installmentPlan InstallmentPlan? @relation(fields: [installmentPlanId], references: [id], onDelete: Restrict)
  paymentIntent   PaymentIntent?   @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@index([userId, service, expiresAt], map: "service_subscriptions_lookup_idx")
  @@index([userId, service, accountType, expiresAt], map: "service_subscriptions_account_lookup_idx")
  @@map("service_subscriptions")
}

// ---------- FindLove payments ----------

enum FindLoveAccountType {
  PRIVATE
  PUBLIC

  @@map("find_love_account_type")
}

enum InstallmentInterval {
  WEEKLY
  MONTHLY
  YEARLY

  @@map("installment_interval")
}

enum PaymentMethod {
  MTN_MOMO
  AIRTEL_MONEY

  @@map("payment_method")
}

enum PaymentStatus {
  CREATED
  PROVIDER_REQUESTED
  AWAITING_USER
  UNKNOWN
  RECONCILING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED

  @@map("payment_status")
}

enum PaymentPurpose {
  FINDLOVE
  ORGANISER_PLAN
  PROMOTION

  @@map("payment_purpose")
}

model InstallmentPlan {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountType  FindLoveAccountType @map("account_type")
  interval     InstallmentInterval
  durationDays Int                 @map("duration_days") @db.SmallInt
  priceMinor   BigInt              @map("price_minor")
  currency     String              @default("RWF") @db.Char(3)
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  paymentIntents PaymentIntent[]
  subscriptions  ServiceSubscription[]

  @@unique([accountType, interval], map: "installment_plans_account_interval_unique")
  @@index([accountType, isActive], map: "installment_plans_account_active_idx")
  @@map("installment_plans")
}

model PaymentIntent {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference             String               @unique @db.VarChar(32)
  userId                String               @map("user_id") @db.Uuid
  installmentPlanId     String?              @map("installment_plan_id") @db.Uuid
  accountType           FindLoveAccountType? @map("account_type")
  purpose               PaymentPurpose       @default(FINDLOVE)
  referenceId           String?              @map("reference_id") @db.Uuid
  amountMinor           BigInt               @map("amount_minor")
  currency              String               @default("RWF") @db.Char(3)
  paymentMethod         PaymentMethod        @map("payment_method")
  phoneNumber           String               @map("phone_number") @db.VarChar(30)
  status                PaymentStatus        @default(CREATED)
  provider              String               @db.VarChar(30)
  providerTransactionId String?              @map("provider_transaction_id") @db.VarChar(128)
  failureReason         String?              @map("failure_reason") @db.VarChar(500)
  idempotencyKey        String?              @map("idempotency_key") @db.VarChar(120)
  expiresAt             DateTime             @map("expires_at") @db.Timestamptz(6)
  providerRequestedAt   DateTime?            @map("provider_requested_at") @db.Timestamptz(6)
  paidAt                DateTime?            @map("paid_at") @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  installmentPlan       InstallmentPlan?       @relation(fields: [installmentPlanId], references: [id], onDelete: Restrict)
  subscription          ServiceSubscription?
  organiserSubscription OrganiserSubscription?
  promotion             Promotion?
  providerEvents        ProviderWebhookEvent[]

  @@unique([userId, idempotencyKey], map: "payment_intents_user_idempotency_unique")
  @@index([userId, createdAt], map: "payment_intents_user_created_idx")
  @@index([status, createdAt], map: "payment_intents_status_created_idx")
  @@index([providerTransactionId], map: "payment_intents_provider_transaction_idx")
  @@index([purpose, referenceId], map: "payment_intents_purpose_reference_idx")
  @@map("payment_intents")
}

model ProviderWebhookEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String    @db.VarChar(30)
  providerEventId String    @map("provider_event_id") @db.VarChar(160)
  paymentIntentId String?   @map("payment_intent_id") @db.Uuid
  eventType       String    @map("event_type") @db.VarChar(80)
  payload         Json
  signatureValid  Boolean   @map("signature_valid")
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  processingError String?   @map("processing_error") @db.VarChar(500)
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId], map: "provider_webhook_events_provider_event_unique")
  @@index([paymentIntentId, receivedAt], map: "provider_webhook_events_payment_idx")
  @@map("provider_webhook_events")
}

model UserBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker User @relation("BlocksCreated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId], map: "user_blocks_unique")
  @@index([blockedId], map: "user_blocks_blocked_idx")
  @@map("user_blocks")
}

model UserReport {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String           @map("reporter_id") @db.Uuid
  reportedUserId String           @map("reported_user_id") @db.Uuid
  conversationId String?          @map("conversation_id") @db.Uuid
  messageId      String?          @map("message_id") @db.Uuid
  reason         String           @db.VarChar(80)
  details        String?          @db.VarChar(2000)
  status         ModerationStatus @default(OPEN)
  reviewedBy     String?          @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  reporter User     @relation("ReportsCreated", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User     @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reviewer User?    @relation("ReportsReviewed", fields: [reviewedBy], references: [id], onDelete: SetNull)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([reportedUserId, createdAt], map: "user_reports_subject_idx")
  @@index([status, createdAt], map: "user_reports_status_idx")
  @@index([messageId], map: "user_reports_message_idx")
  @@map("user_reports")
}

// ---------- Eventis specification: events, publishers and organisations ----------

model SavedEvent {
  userId    String   @map("user_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [eventId], onDelete: Cascade)

  @@id([userId, eventId], map: "saved_events_pkey")
  @@index([eventId], map: "saved_events_event_idx")
  @@map("saved_events")
}

model SavedOrganiser {
  userId         String   @map("user_id") @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([userId, organisationId], map: "saved_organisers_pkey")
  @@index([organisationId], map: "saved_organisers_organisation_idx")
  @@map("saved_organisers")
}

model Review {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  rating    Int       @db.SmallInt
  comment   String?   @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], map: "reviews_event_user_unique")
  @@index([eventId, createdAt], map: "reviews_event_created_idx")
  @@map("reviews")
}

enum OrganisationVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED

  @@map("organisation_verification_status")
}

enum OrganisationRole {
  OWNER
  ADMIN
  EDITOR

  @@map("organisation_role")
}

model Organisation {
  id                 String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId            String                         @map("owner_id") @db.Uuid
  name               String                         @db.VarChar(80)
  description        String                         @db.Text
  activities         String                         @db.VarChar(300)
  location           String                         @db.VarChar(120)
  website            String?                        @db.VarChar(500)
  logoKey            String?                        @map("logo_key") @db.VarChar(500)
  businessType       String?                        @map("business_type") @db.VarChar(80)
  verificationStatus OrganisationVerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?                      @map("deleted_at") @db.Timestamptz(6)

  owner                User                  @relation("OrganisationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members              OrganisationMember[]
  events               Event[]
  savedBy              SavedOrganiser[]
  businessVerification BusinessVerification?
  activeForUsers       User[]                @relation("ActiveOrganisation")

  @@index([ownerId], map: "organisations_owner_idx")
  @@index([verificationStatus], map: "organisations_verification_idx")
  @@index([name], map: "organisations_name_idx")
  @@map("organisations")
}

model OrganisationMember {
  organisationId String           @map("organisation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganisationRole @default(EDITOR)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organisationId, userId], map: "organisation_members_pkey")
  @@index([userId], map: "organisation_members_user_idx")
  @@map("organisation_members")
}

model PublisherProfile {
  userId             String   @id @map("user_id") @db.Uuid
  contactEmail       String?  @map("contact_email") @db.VarChar(255)
  contactPhone       String?  @map("contact_phone") @db.VarChar(30)
  website            String?  @db.VarChar(500)
  socialLinks        Json     @default("{}") @map("social_links")
  legalName          String?  @map("legal_name") @db.VarChar(160)
  registrationNumber String?  @map("registration_number") @db.VarChar(30)
  taxIdEncrypted     String?  @map("tax_id_encrypted") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories PublisherProfileCategory[] @relation("PublisherProfileCategories")

  @@map("publisher_profiles")
}

model PublisherProfileCategory {
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile  PublisherProfile @relation("PublisherProfileCategories", fields: [userId], references: [userId], onDelete: Cascade)
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId], map: "publisher_profile_categories_pkey")
  @@index([categoryId], map: "publisher_profile_categories_category_idx")
  @@map("publisher_profile_categories")
}

model EventReport {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String           @map("event_id") @db.Uuid
  reporterId String           @map("reporter_id") @db.Uuid
  reason     String           @db.VarChar(200)
  details    String?          @db.Text
  status     ModerationStatus @default(OPEN)
  reviewedBy String?          @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  event    Event @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  reporter User  @relation("EventReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer User? @relation("EventReportReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt], map: "event_reports_event_idx")
  @@index([status, createdAt], map: "event_reports_status_idx")
  @@map("event_reports")
}

