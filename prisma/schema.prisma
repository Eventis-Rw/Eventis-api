  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "account_deletion_challenges_user_idx")
  @@map("account_deletion_challenges")
}

// ---------- Eventis specification: organiser monetisation and trust ----------

enum OrganiserPlanInterval {
  PAY_PER_POST
  MONTHLY
  QUARTERLY
  YEARLY

  @@map("organiser_plan_interval")
}

model OrganiserPlan {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String                @unique @db.VarChar(50)
  name         String                @db.VarChar(120)
  interval     OrganiserPlanInterval
  priceMinor   BigInt                @map("price_minor")
  currency     String                @default("RWF") @db.Char(3)
  durationDays Int                   @map("duration_days")
  postQuota    Int?                  @map("post_quota")
  features     Json                  @default("[]")
  recommended  Boolean               @default(false)
  badge        String?               @db.VarChar(40)
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions OrganiserSubscription[]

  @@index([active, interval], map: "organiser_plans_active_idx")
  @@map("organiser_plans")
}

enum OrganiserSubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED

  @@map("organiser_subscription_status")
}

model OrganiserSubscription {
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String                      @map("user_id") @db.Uuid
  planId         String                      @map("plan_id") @db.Uuid
  status         OrganiserSubscriptionStatus @default(PENDING)
  startsAt       DateTime?                   @map("starts_at") @db.Timestamptz(6)
  expiresAt      DateTime?                   @map("expires_at") @db.Timestamptz(6)
  postsRemaining Int?                        @map("posts_remaining")
  paymentId      String?                     @unique @map("payment_id") @db.Uuid
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    OrganiserPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment PaymentIntent? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId, status, expiresAt], map: "organiser_subscriptions_user_idx")
  @@map("organiser_subscriptions")
}

enum BusinessVerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("business_verification_status")
}

model BusinessVerification {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String                     @unique @map("organisation_id") @db.Uuid
  legalName          String                     @map("legal_name") @db.VarChar(160)
  registrationNumber String                     @map("registration_number") @db.VarChar(30)
  taxIdEncrypted     String                     @map("tax_id_encrypted") @db.Text
  representativeName String                     @map("representative_name") @db.VarChar(160)
  paymentWebsite     String                     @map("payment_website") @db.VarChar(500)
  documentKey        String                     @map("document_key") @db.VarChar(500)
  status             BusinessVerificationStatus @default(PENDING)
  rejectionReason    String?                    @map("rejection_reason") @db.Text
  submittedAt        DateTime                   @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt         DateTime?                  @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy         String?                    @map("reviewed_by") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("BusinessVerificationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status, submittedAt], map: "business_verifications_status_idx")
  @@map("business_verifications")
}

enum PromotionPlacement {
  HOME_BANNER
  FEATURED
  CATEGORY_HIGHLIGHT
  NEARBY_PROMOTED
  SPONSORED_AD

  @@map("promotion_placement")
}

enum PromotionStatus {
  REQUESTED
  APPROVED
  ACTIVE
  EXPIRED
  REJECTED
  CANCELLED

  @@map("promotion_status")
}

model Promotion {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId         String             @map("event_id") @db.Uuid
  ownerId         String             @map("owner_id") @db.Uuid
  placement       PromotionPlacement
  durationDays    Int                @map("duration_days")
  status          PromotionStatus    @default(REQUESTED)
  priceMinor      BigInt?            @map("price_minor")
  paymentId       String?            @unique @map("payment_id") @db.Uuid
  startsAt        DateTime?          @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime?          @map("ends_at") @db.Timestamptz(6)
  rejectionReason String?            @map("rejection_reason") @db.Text
  reviewedBy      String?            @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  event    Event          @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  owner    User           @relation("PromotionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  payment  PaymentIntent? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  reviewer User?          @relation("PromotionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([eventId, status], map: "promotions_event_status_idx")
  @@index([status, placement], map: "promotions_status_placement_idx")
  @@map("promotions")
}

enum AnalyticsEventType {
  IMPRESSION
  VIEW
  CLICK
  SAVE
  SHARE
  WEBSITE_CLICK

  @@map("analytics_event_type")
}

model AnalyticsEvent {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String             @map("event_id") @db.Uuid
  userId    String?            @map("user_id") @db.Uuid
  type      AnalyticsEventType
  source    String?            @db.VarChar(60)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId, type, createdAt], map: "analytics_events_event_type_idx")
  @@index([eventId, createdAt], map: "analytics_events_event_created_idx")
  @@index([userId, createdAt], map: "analytics_events_user_idx")
  @@map("analytics_events")
}

model EventStatDaily {
  eventId       String   @map("event_id") @db.Uuid
  date          DateTime @db.Date
  impressions   Int      @default(0)
  views         Int      @default(0)
  clicks        Int      @default(0)
  saves         Int      @default(0)
  shares        Int      @default(0)
  websiteClicks Int      @default(0) @map("website_clicks")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [eventId], onDelete: Cascade)

  @@id([eventId, date], map: "event_stats_daily_pkey")
  @@index([date], map: "event_stats_daily_date_idx")
  @@map("event_stats_daily")
}

// ---------- Eventis specification: FindLove ----------

enum AgeDocumentType {
  NATIONAL_ID
  PASSPORT

  @@map("age_document_type")
}

enum AgeVerificationStatus {
  PROCESSING
  MANUAL_REVIEW
  VERIFIED
  REJECTED
  FAILED

  @@map("age_verification_status")
}

model AgeVerification {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                @map("user_id") @db.Uuid
  documentType     AgeDocumentType       @map("document_type")
  frontKey         String                @map("front_key") @db.VarChar(500)
  backKey          String?               @map("back_key") @db.VarChar(500)
  adultConfirmedAt DateTime?             @map("adult_confirmed_at") @db.Timestamptz(6)
  status           AgeVerificationStatus @default(PROCESSING)
  rejectionReason  String?               @map("rejection_reason") @db.Text
  dateOfBirth      DateTime?             @map("date_of_birth") @db.Date
  reviewedBy       String?               @map("reviewed_by") @db.Uuid
  submittedAt      DateTime              @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt       DateTime?             @map("reviewed_at") @db.Timestamptz(6)

  user     User  @relation("AgeVerificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("AgeVerificationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId, submittedAt], map: "age_verifications_user_idx")
  @@index([status, submittedAt], map: "age_verifications_status_idx")
  @@map("age_verifications")
}

enum LoveGender {
  MAN
  WOMAN
  PREFER_NOT_TO_SAY

  @@map("love_gender")
}

enum LoveInterestedIn {
  WOMEN
  MEN
  EVERYONE

  @@map("love_interested_in")
}

enum LoveRelationshipGoal {
  FRIENDSHIP
  LONG_TERM
  SHORT_TERM
  MARRIAGE
  CASUAL
  NOT_SURE

  @@map("love_relationship_goal")
}

model LoveProfile {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                @unique @map("user_id") @db.Uuid
  username         String                @unique @db.VarChar(20)
  gender           LoveGender
  interestedIn     LoveInterestedIn      @map("interested_in")
  dateOfBirth      DateTime              @map("date_of_birth") @db.Date
  country          String                @db.VarChar(80)
  city             String                @db.VarChar(80)
  neighborhood     String                @db.VarChar(80)
  occupation       String?               @db.VarChar(120)
  bio              String?               @db.VarChar(160)
  interests        String[]              @default([])
  relationshipGoal LoveRelationshipGoal? @map("relationship_goal")
  lookingFor       String?               @map("looking_for") @db.VarChar(120)
  isHidden         Boolean               @default(false) @map("is_hidden")
  lastActiveAt     DateTime?             @map("last_active_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos              LoveProfilePhoto[]
  likesSent           LoveLike[]         @relation("LoveLikesSent")
  likesReceived       LoveLike[]         @relation("LoveLikesReceived")
  connectionsSent     LoveConnection[]   @relation("LoveConnectionsSent")
  connectionsReceived LoveConnection[]   @relation("LoveConnectionsReceived")

  @@index([country, city, isHidden], map: "love_profiles_discovery_idx")
  @@index([lastActiveAt], map: "love_profiles_active_idx")
  @@map("love_profiles")
}

model LoveProfilePhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  key       String   @db.VarChar(500)
  position  Int      @default(0) @db.SmallInt
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile LoveProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position], map: "love_profile_photos_profile_idx")
  @@map("love_profile_photos")
}

model LoveLike {
  fromProfileId String   @map("from_profile_id") @db.Uuid
  toProfileId   String   @map("to_profile_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fromProfile LoveProfile @relation("LoveLikesSent", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfile   LoveProfile @relation("LoveLikesReceived", fields: [toProfileId], references: [id], onDelete: Cascade)

  @@id([fromProfileId, toProfileId], map: "love_likes_pkey")
  @@index([toProfileId, createdAt], map: "love_likes_recipient_idx")
  @@map("love_likes")
}

enum LoveConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  REMOVED

  @@map("love_connection_status")
}

model LoveConnection {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromProfileId  String               @map("from_profile_id") @db.Uuid
  toProfileId    String               @map("to_profile_id") @db.Uuid
  status         LoveConnectionStatus @default(PENDING)
  message        String?              @db.VarChar(500)
  conversationId String?              @map("conversation_id") @db.Uuid
  respondedAt    DateTime?            @map("responded_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  fromProfile  LoveProfile   @relation("LoveConnectionsSent", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfile    LoveProfile   @relation("LoveConnectionsReceived", fields: [toProfileId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([toProfileId, status, createdAt], map: "love_connections_recipient_idx")
  @@index([fromProfileId, status, createdAt], map: "love_connections_sender_idx")
  @@map("love_connections")
}

// ---------- Eventis specification: chat improvements ----------

model ContactAlias {
  ownerId       String   @map("owner_id") @db.Uuid
  phone         String   @db.VarChar(30)
  contactUserId String?  @map("contact_user_id") @db.Uuid
  firstName     String   @map("first_name") @db.VarChar(100)
  lastName      String?  @map("last_name") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner       User  @relation("ContactAliases", fields: [ownerId], references: [id], onDelete: Cascade)
  contactUser User? @relation("ContactAliasTarget", fields: [contactUserId], references: [id], onDelete: SetNull)

  @@id([ownerId, phone], map: "contact_aliases_pkey")
  @@index([ownerId, firstName], map: "contact_aliases_owner_name_idx")
  @@map("contact_aliases")
}
