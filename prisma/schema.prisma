  promotional           Boolean  @default(false)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

model UserPreference {
  userId            String   @id @map("user_id") @db.Uuid
  preferredLocation String?  @map("preferred_location") @db.VarChar(120)
  latitude          Decimal? @db.Decimal(9, 6)
  longitude         Decimal? @db.Decimal(9, 6)
  language          String?  @db.VarChar(10)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserPreferenceCategory {
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId], map: "user_preference_categories_pkey")
  @@index([categoryId], map: "user_preference_categories_category_idx")
  @@map("user_preference_categories")
}

enum PhoneVerificationPurpose {
  SETTINGS
  PAYMENT
  CHAT

  @@map("phone_verification_purpose")
}

model PhoneVerification {
