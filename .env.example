# Copy to .env and fill in. NEVER commit .env — this repository is public.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres with PostGIS. docker/docker-compose.yml provides this locally.
DATABASE_URL=postgresql://eventis:eventis@localhost:5432/eventis
# Deliberately small. Each API instance holds its own pool; the default of 10 per
# instance times N instances is how you exhaust Postgres connections.
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# Signing keys. Generate with: bun run scripts/generate-keys.ts
# The PRIVATE key never leaves the server. The scanner ships only the public key.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TICKET_SIGNING_PRIVATE_KEY=
TICKET_SIGNING_PUBLIC_KEY=
TICKET_SIGNING_KEY_VERSION=1

# Object storage (Cloudflare R2 / MinIO locally)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=eventis-dev
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Payments. Use 'fake' everywhere except production — nobody develops against real credentials.
PAYMENT_PROVIDER=fake
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# SMS gateway for OTP
SMS_PROVIDER=fake
SMS_API_KEY=

SENTRY_DSN=
