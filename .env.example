# Copy to .env and fill in. NEVER commit .env — this repository is public.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres with PostGIS. docker/docker-compose.yml maps host 5433 → container 5432
# so a local Postgres already on 5432 does not block compose.
DATABASE_URL=postgresql://eventis:eventis@localhost:5433/eventis
# Deliberately small. Each API instance holds its own pool; the default of 10 per
# instance times N instances is how you exhaust Postgres connections.
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# Signing keys. Generate with: bun run scripts/generate-keys.ts
# The PRIVATE key never leaves the server. The scanner ships only the public key.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TICKET_SIGNING_PRIVATE_KEY=
TICKET_SIGNING_PUBLIC_KEY=
TICKET_SIGNING_KEY_VERSION=1

# Object storage (Cloudflare R2 / MinIO locally)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=eventis-dev
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Required for event cover uploads. Event covers are always stored in Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Deep link scheme must match artifacts/mobile/app.json
MOBILE_APP_SCHEME=mobile

# Payments. Use 'fake' everywhere except production — nobody develops against real credentials.
PAYMENT_PROVIDER=fake
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# SMS gateway for OTP.
# - fake: no network (local/tests)
# - africas_talking: real OTP via Africa's Talking → MTN/Airtel Rwanda
#
# For REAL delivery to phones set:
#   SMS_PROVIDER=africas_talking
#   AT_ENV=production
#   AT_USERNAME=<your live AT app username>
#   AT_API_KEY=<your live AT api key>
#   AT_SENDER_ID=<optional registered sender / shortcode>
#

SMS_PROVIDER=fake
AT_USERNAME=sandbox
AT_API_KEY=
AT_ENV=sandbox
AT_SENDER_ID=

# Email (payment submitted/approved/rejected notices, etc.)
# - fake: no network, logs instead of sending (local/tests)
# - brevo: real email via Brevo's transactional email API
#
# For REAL delivery set:
#   EMAIL_PROVIDER=brevo
#   BREVO_API_KEY=<your Brevo API key>
#   BREVO_SENDER_EMAIL=<a verified sender address>
#   BREVO_SENDER_NAME=<optional display name>

EMAIL_PROVIDER=fake
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Optional TURN relay for reliable in-app voice/video calls on carrier and
# restrictive Wi-Fi networks. Configure coturn with use-auth-secret and the
# same shared secret. URLs are comma-separated, e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# Without TURN, Eventis uses public STUN and some carrier networks may not connect.
CALL_STUN_URLS=stun:stun.l.google.com:19302
CALL_TURN_URLS=
CALL_TURN_SHARED_SECRET=

# Access tokens are short-lived; refresh tokens last longer (ADR 0006).
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

SENTRY_DSN=

# DEV ONLY: auto-approve FindLove age verification (refused when NODE_ENV=production)
FINDLOVE_AGE_AUTO_APPROVE=false
# DEV ONLY: grant a default FindLove membership instead of requiring a real payment (refused when NODE_ENV=production)
FINDLOVE_MEMBERSHIP_AUTO_APPROVE=false

# Add these server-only values to the API environment.
# GOOGLE_AUTH_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com
# APPLE_AUTH_CLIENT_IDS=your.registered.ios.bundle.identifier
# BREVO_API_KEY=your-brevo-api-key
# AUTH_EMAIL_FROM=Eventis <auth@your-verified-domain.example>

# Receipt-only deployment: PAYMENT_PROVIDER=manual disables automated collections.
# Without email credentials: EMAIL_PROVIDER=disabled rejects email OTP requests.

# Initial admin account. Server-only; never commit real seed credentials.
# ADMIN_SEED_EMAIL=admin@your-domain.com
# ADMIN_SEED_PASSWORD=choose-a-strong-password-at-least-12-characters
# ADMIN_SEED_NAME=Eventis Admin
# Re-running preserves an existing password unless explicitly rotating:
# ADMIN_SEED_ROTATE_PASSWORD=false
