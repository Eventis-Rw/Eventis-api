{
  "name": "@eventis/api",
  "version": "0.1.0",
  "private": true,
  "description": "Eventis API — modular monolith for event discovery, listing, ticketing and check-in",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "nodemon --watch src --watch prisma/schema.prisma --ext ts,json,prisma --exec \"bun run check:runtime && bun run build && node dist/main.js\"",
    "dev:worker": "bun --watch src/worker.ts",
    "build": "bunx --bun prisma generate && tsc -p tsconfig.build.json",
    "check:runtime": "node -e \"const [major, minor] = process.versions.node.split('.').map(Number); if (major < 18 || (major === 18 && minor < 18)) { console.error('Unsupported Node.js ' + process.version + '. Use nvm use 20 (or Node >= 18.18.0) before starting Eventis API.'); process.exit(1); }\"",
    "start": "bun run check:runtime && bun run build && node dist/main.js",
    "start:worker": "bun run dist/worker.js",
    "start:node": "bun run check:runtime && bun run build && node dist/main.js",
    "typecheck": "bunx --bun prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "bun test src",
    "test:integration": "bun test test/integration",
    "depcruise": "bunx --bun depcruise src --config .dependency-cruiser.cjs",
    "depcruise:verify": "bash scripts/verify-boundaries.sh",
    "guard:money": "bash scripts/guard-money.sh",
    "db:generate": "prisma migrate dev --name",
    "db:migrate": "bunx --bun prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "bun run scripts/seed.ts",
    "prisma:generate": "prisma generate",
    "openapi": "bun run scripts/generate-openapi.ts",
    "verify": "bun run lint && bun run typecheck && bun run depcruise && bun run depcruise:verify && bun run guard:money && bun run test && bun run build"
  },
  "dependencies": {
    "@eventis/contracts": "link:@eventis/contracts",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@prisma/client": "6.16.2",
    "bullmq": "^6.3.6",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eventis/eslint-config": "link:@eventis/eslint-config",
    "@eventis/tsconfig": "link:@eventis/tsconfig",
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "^1.4.2",
    "dependency-cruiser": "^18.3.0",
    "eslint": "^10.10.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.9.6",
    "prisma": "6.16.2",
    "typescript": "~5.9.3"
  }
}
