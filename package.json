{
  "name": "@eventis/api",
  "version": "0.1.0",
  "private": true,
  "description": "Eventis API \u2014 modular monolith for event discovery, listing, ticketing and check-in",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "dev:worker": "bun --watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun run dist/main.js",
    "start:worker": "bun run dist/worker.js",
    "start:node": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "bun test src",
    "test:integration": "bun test test/integration",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "depcruise:verify": "bash scripts/verify-boundaries.sh",
    "guard:money": "bash scripts/guard-money.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/infra/database/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed.ts",
    "openapi": "bun run scripts/generate-openapi.ts > openapi.json",
    "verify": "bun run lint && bun run typecheck && bun run depcruise && bun run depcruise:verify && bun run guard:money && bun run test && bun run build"
  },
  "dependencies": {
    "@eventis/contracts": "^0.1.0",
    "@fastify/helmet": "^13.1.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "bullmq": "^6.3.6",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eventis/eslint-config": "^0.1.0",
    "@eventis/tsconfig": "^0.1.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "^1.4.2",
    "dependency-cruiser": "^18.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
